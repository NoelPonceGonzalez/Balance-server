PORT=3010
NODE_ENV=development
# Base distinta de Powerlifting. El nombre de la base tiene que ser patrimonio.
MONGODB_URI=mongodb+srv://USUARIO:CONTRASEÑA@cluster.mongodb.net/patrimonio?retryWrites=true&w=majority
JWT_SECRET=cambia-esto-por-una-cadena-larga
# Orígenes del navegador. En Amazon también vale cualquier https://*.vercel.app.
# CORS_ORIGINS=http://54.163.218.235:3010
# Carpeta del cliente ya construido. Si existe, la API también sirve la web.
# CLIENT_DIST=./public
# Opcional. Sin ella se usa la API pública de CoinGecko.
# COINGECKO_API_KEY=
# Correo del código para cambiar la contraseña. Los mismos datos que Powerlifting.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=
# EMAIL_PASS=
# EMAIL_FROM=
